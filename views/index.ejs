<html lang="no">
<%- include("./partials/head.ejs") %>
<body>
  <%- include("./partials/nav.ejs") %>
  <h1>Julekalender</h1>
  <div id="kalenderinfo"></div>

  <div id="wrapper">
    <div id="boxtop"></div>
    <div id="kalender">
      <ul id="kalenderluker"></ul>
    </div>
  </div>

  <dialog id="popup">
    <div id="popupinnhold"></div>
    <button type="button" id="lukk">Lukk</button>
  </dialog>

  <% const kalenderData = {
    questions: questions.map(sporsmal => ({
      id: sporsmal.id,
      question: sporsmal.question,
      options: sporsmal.options || [],
      video_url: sporsmal.video_url || null
    })),
    participantName: participant ? participant.name : null,
    submitted
  }; %>
  <script id="kalenderdata" type="application/json"><%- JSON.stringify(kalenderData).replace(/</g, "\\u003c") %></script>
</body>
</html>